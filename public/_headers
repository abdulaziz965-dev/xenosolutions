# Cloudflare Pages response headers

# Built JS/CSS have a unique name per build, so browsers can keep them for a year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Basic security headers for every page
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'self' https://abdulrahmandev.pages.dev https://*.abdulrahmandev.pages.dev
  Permissions-Policy: camera=(), microphone=(), geolocation=()